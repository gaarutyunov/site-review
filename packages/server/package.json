{
  "name": "@site-review/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "site-review-mcp": "./dist/stdio.js",
    "site-review-server": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
