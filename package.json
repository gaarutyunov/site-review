{
  "name": "site-review",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension + MCP server for leaving comments on website elements for AI agents to fix.",
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "dev:server": "pnpm --filter @site-review/server dev",
    "dev:extension": "pnpm --filter @site-review/extension dev",
    "dev:landing": "pnpm --filter @site-review/landing dev",
    "build": "pnpm -r build",
    "build:server": "pnpm --filter @site-review/server build",
    "build:extension": "pnpm --filter @site-review/extension build",
    "build:landing": "pnpm --filter @site-review/landing build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:server": "pnpm --filter @site-review/server start",
    "docker:build": "docker build -f packages/server/Dockerfile -t ghcr.io/gaarutyunov/site-review:local .",
    "docker:run": "docker run --rm -p 4711:4711 -v $HOME/.site-review:/data ghcr.io/gaarutyunov/site-review:local"
  }
}
